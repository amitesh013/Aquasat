# Neon PostgreSQL pooled or direct URL. Keep this server-only and out of Git.
DATABASE_URL=

# Keep false for local HTTP development; set true for HTTPS deployment.
AQUASAT_COOKIE_SECURE=false

# Allowed browser origins for local Vite development.
AQUASAT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
